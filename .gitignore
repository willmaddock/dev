# Hugo generated output (public directory where the static site is built)
public/

# Hugo cache and temporary files
resources/_gen/
.hugo_build.lock

# Local environment and IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db

# Dependency directories (if you install tools locally)
node_modules/
vendor/

# Sensitive or local configuration files
config.local.toml
.env
*.bak
*.tmp

# Logs and temporary files
*.log
tmp/
